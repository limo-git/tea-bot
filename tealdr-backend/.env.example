DISCORD_BOT_TOKEN=your_discord_bot_token_here
SUPABASE_PROJECT_URL=your_supabase_project_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
EXCLUDED_CHANNELS=channel_id_1,channel_id_2
LOG_LEVEL=INFO
MESSAGE_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# ── Graph RAG (set GRAPH_RAG_ENABLED=true to activate) ──────────────────────
GRAPH_RAG_ENABLED=false

# Gemini model used for Graph RAG (reuses your existing GEMINI_API_KEY)
GRAPH_RAG_MODEL=gemini-3-flash-preview

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Graph RAG tuning (optional, defaults shown)
EXPERT_IN_THRESHOLD=5
CHUNK_WINDOW_MINUTES=15
RELATIONSHIP_DECAY_DAYS=30
VECTOR_TOP_K=10
